# Red Docker de Nginx Proxy Manager (docker network ls). Suele ser <carpeta>_default
NPM_NETWORK=nginx-proxy-manager_default
# URL pública (se usa en los enlaces de los emails)
PUBLIC_URL=https://ancares.example.com

# Admin: cambia ambos valores. SECRET_KEY: cadena larga aleatoria
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_PASSWORD=cambiame
SECRET_KEY=cambiame-por-una-cadena-larga
COOKIE_SECURE=true

# Sincronización diaria con la FVCL (formato cron, hora de Madrid)
SYNC_ENABLED=true
SYNC_CRON=0 7 * * *
USER_AGENT=AncaresSeguidores/1.0 (app no oficial de seguidores; contacto en la app)
# Resolver la prueba de trabajo de fvcl.es (pon false si la federación lo pide)
POW_ENABLED=true
POW_MAX_SECONDS=60

# Email para avisos de feedback y de descargas bloqueadas (vacío = desactivado)
# Gmail: smtp.gmail.com / 587 con una "contraseña de aplicación"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=
ADMIN_EMAIL=
