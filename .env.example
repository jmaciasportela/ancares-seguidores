# URL pública (se usa en los enlaces de los emails)
PUBLIC_URL=https://ancares.example.com

# Admin: cambia ambos valores. SECRET_KEY: cadena larga aleatoria
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_PASSWORD=cambiame
SECRET_KEY=cambiame-por-una-cadena-larga
COOKIE_SECURE=true

# Sincronización con la FVCL (formato cron, hora de Madrid): a las 12:00 y a las 16:00
SYNC_ENABLED=true
SYNC_CRON=0 12,16 * * *
USER_AGENT=AncaresSeguidores/1.0 (app no oficial de seguidores; contacto en la app)

# Resolver la prueba de trabajo de fvcl.es (pon false si la federación lo pide)
POW_ENABLED=true
POW_MAX_SECONDS=60

# Previsión del tiempo en las tarjetas (Open-Meteo, gratis y sin clave)
WEATHER_ENABLED=true
# Ciudad si no se puede deducir del pabellón ni del equipo local
WEATHER_DEFAULT_CITY=Valladolid

# Email para avisos de feedback y de descargas bloqueadas.
# Hacen falta como mínimo SMTP_HOST y ADMIN_EMAIL (si faltan, no se envía nada).
# Pruébalo en Admin → Feedback → «Enviar email de prueba»: muestra el error si falla.
#   Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu dirección y en
#          SMTP_PASSWORD una «contraseña de aplicación» (no tu contraseña normal).
#   Puerto 465: SSL directo (se activa solo); 587: STARTTLS.
#   Algunos proveedores de VPS bloquean la salida por los puertos 25 y 465: usa 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# SMTP_SSL=true   (opcional: fuerza SSL directo aunque el puerto no sea 465)
SMTP_FROM=
ADMIN_EMAIL=
